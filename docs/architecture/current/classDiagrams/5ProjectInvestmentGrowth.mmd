---
title: Project Investment Growth - Class Diagram
---
classDiagram
    direction TB

    class InvestmentView {}
    class Controller {
        +projectInvestment(balance, apy, contribution, years)
    }
    class Validator {
        +validateInvestmentFields(...)
    }
    class Investment {
        -balance: double
        -apyDecimal: double
        -monthlyContribution: double
        -label: String
        +growthOverTime(years) ArrayList~Double~
    }
    class CompoundInterestCalculator {
        -principalAmount: double
        -rate: double
        -periodicContribution: double
        -numberOfCompoundsPerYear: int
        -numberYears: int
        +getAmountOverTime() double
        +getBalanceOverTime() ArrayList~Double~
    }
    class Limits {
        +MAX_PROJECTION_YEARS: int
    }

    InvestmentView --> Controller
    InvestmentView --> Validator
    Validator ..> Limits
    Controller ..> Investment
    Investment ..> CompoundInterestCalculator : uses

%% Relationships Reference
%% classA --|> classB : Inheritance

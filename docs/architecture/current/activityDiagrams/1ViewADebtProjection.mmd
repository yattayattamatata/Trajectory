swimlane-beta TB
  subgraph user [Finance User]
    S((Start))
    A1[Select debt]
    A2[Enter proposed payment]
    A3[Click View Projection]
    E((End))
  end
  subgraph ui [User Interface]
    B1[Validate payment]
    D1{Payment valid?}
    B2[Display error beside payment field]
    D2{Result?}
    B3[Display months, total interest, and monthly balances with estimates disclaimer]
    B4[Display message that the payment is insufficient]
    B5[Display message that the debt cannot be paid off within 100 years]
  end
  subgraph ctrl [Controller]
    C1[Request projection]
    C2[Return result to interface]
  end
  subgraph model [Debt Model]
    M1[Calculate interest, apply payment, record balance for the month]
    D3{Paid off or maximum period reached?}
    M2[Create DebtPayoffResult]
  end
  S --> A1 --> A2 --> A3 --> B1 --> D1
  D1 -->|No| B2 --> A2
  D1 -->|Yes| C1 --> M1 --> D3
  D3 -->|No| M1
  D3 -->|Yes| M2 --> C2 --> D2
  D2 -->|Payable| B3 --> E
  D2 -->|Payment too low| B4 --> E
  D2 -->|Exceeds maximum term| B5 --> E

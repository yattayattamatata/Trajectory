---
title: Create a Budget
---
sequenceDiagram
    actor FU as Tom: Finance User
    participant UI as :UserInterface
    participant V as :Validator
    participant C as :Controller
    participant U as :User

    FU ->>+ UI: Enter budget name, month, and year, click Create Budget
    UI ->>+ V: Validate budget fields
    V -->>- UI: Return field errors (if any)

    alt Any field invalid
        UI -->> FU: Display error beside each invalid field
    else All fields valid
        UI ->>+ C: Request create budget (name, month, year)
        create participant B as newBudget:Budget
        C ->> B: Create budget (name, month, year)
        C ->>+ U: addBudget(newBudget)
        U -->>- C: Confirm budget added
        C -->>- UI: Return newBudget
        UI -->> FU: Display empty budget ready for entries

        loop until the user adds all budget items
            FU ->> UI: Select category, enter amount, click Add Entry
            UI ->>+ V: Validate entry fields
            V -->>- UI: Return field errors (if any)
            alt Any field invalid
                UI -->> FU: Display error beside each invalid field
            else All fields valid
                UI ->>+ C: Request add entry (category, amount)
                create participant E as newEntry:BudgetEntry
                C ->> E: Create entry (category, amount)
                C ->>+ B: addEntry(newEntry)
                B -->>- C: Confirm entry added
                C ->>+ B: Get totals (income, expense, remaining)
                B -->>- C: Return totals
                C -->>- UI: Return updated totals
                UI -->> FU: Display entry and updated totals
            end
        end
        UI -->> FU: Show budget in the budget list
    end
    deactivate UI

---
title: Load a Saved Profile
---
sequenceDiagram
    actor FU as Tom: Finance User
    participant UI as :UserInterface
    participant C as :Controller
    participant UR as :UserRepository
    participant DR as :DebtRepository
    participant IR as :InvestmentRepository
    participant BR as :BudgetRepository
    participant DB as :DatabaseManager

    FU ->>+ UI: Select profile and click Load
    UI ->>+ C: Request user with ID
    C ->>+ UR: Load user with ID
    UR ->>+ DB: Get user row
    DB -->>- UR: Return user row

    alt User found
        create participant LU as loadedUser:User
        UR ->> LU: Create user

        UR ->>+ DR: Load debts for user ID
        DR -->>- UR: Return debts
        UR ->>+ LU: Add debts to user
        deactivate LU

        UR ->>+ IR: Load investments for user ID
        IR -->>- UR: Return investments
        UR ->>+ LU: Add investments to user
        deactivate LU

        UR ->>+ BR: Load budgets and entries for user ID
        BR -->>- UR: Return budgets
        UR ->>+ LU: Add budgets to user
        deactivate LU

        UR -->>- C: Return loadedUser
        C ->> C: Store loadedUser as currentUser
        C -->> UI: Return currentUser
        UI -->> FU: Show profile
    else User not found or database error
        UR -->> C: Return error
        C -->> UI: Return error
        UI -->> FU: Show error message
    end
    deactivate C
    deactivate UI

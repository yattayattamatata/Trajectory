---
title: View a Debt Projection
---
sequenceDiagram
    actor FU as Tom: Finance User
    participant UI as :UserInterface
    participant V as :Validator
    participant C as :Controller
    participant D as selectedDebt:Debt

    FU ->>+ UI: Select debt, enter proposed payment, click View Projection
    UI ->>+ V: Validate payment
    V -->>- UI: Return field errors (if any)

    alt Payment invalid
        UI -->> FU: Display error beside the payment field
    else Payment valid
        UI ->>+ C: Request projection (selectedDebt, payment)
        C ->>+ D: projectPayoffTimeline(payment)
        loop each month, up to the maximum projection period
            D ->> D: Calculate interest, apply payment, record balance
        end
        create participant R as :DebtPayoffResult
        D ->> R: Create result (status, months, total interest, monthly balances)
        D -->>- C: Return DebtPayoffResult
        C -->>- UI: Return DebtPayoffResult

        alt payable
            UI -->> FU: Display months, total interest, and monthly balances (graph and table) with estimates disclaimer
        else payment too low
            UI -->> FU: Display message that the payment is insufficient to pay off the debt
        else exceeds maximum term
            UI -->> FU: Display message that the debt cannot be paid off within 100 years
        end
    end
    deactivate UI
